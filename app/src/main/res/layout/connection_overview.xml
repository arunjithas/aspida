<?xml version="1.0" encoding="utf-8"?>
<!--
  Connection detail view.
  All original view IDs are preserved so ConnectionOverview.java needs no changes.
  The TableLayout (id=table) is kept intact for copy-to-clipboard text extraction.
  Section-header rows have only 1 child, so table2Text() ignores them safely.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/connection_overview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ── Connection details card ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <TableLayout
                android:id="@+id/table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shrinkColumns="1"
                android:stretchColumns="1"
                android:padding="16dp">

                <!-- ── Section: Connection ── -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_span="2"
                        android:text="@string/connection_details"
                        style="@style/StatCardLabel"
                        android:paddingBottom="4dp"
                        android:layout_marginBottom="4dp" />
                </TableRow>

                <!-- App -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/app" />
                    <TextView
                        android:id="@+id/detail_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="Chrome (14503)" />
                </TableRow>

                <!-- Protocol -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/protocol" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/detail_protocol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            tools:text="TLS (TCP)" />
                        <ImageView
                            android:id="@+id/protocol_info"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:paddingTop="1sp"
                            android:paddingStart="4dp"
                            android:src="@drawable/ic_info" />
                    </LinearLayout>
                </TableRow>

                <!-- SNI / Info -->
                <TableRow
                    android:id="@+id/detail_info_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:id="@+id/detail_info_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/sni" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/blacklisted_host"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_skull"
                            app:tint="@color/danger" />
                        <TextView
                            android:id="@+id/detail_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            tools:text="ssl.example.com" />
                    </LinearLayout>
                </TableRow>

                <!-- Source -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/source" />
                    <TextView
                        android:id="@+id/detail_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        tools:text="1.2.3.4:14631" />
                </TableRow>

                <!-- Destination -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/destination" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/blacklisted_ip"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_skull"
                            app:tint="@color/danger"
                            android:contentDescription="@string/malicious_connection_filter" />
                        <TextView
                            android:id="@+id/detail_destination"
                            android:layout_gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            tools:text="5.6.7.8:443" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/whois_ip"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="0dp"
                            android:paddingHorizontal="6dp"
                            android:drawableEnd="@drawable/ic_external"
                            app:drawableTint="@color/colorPrimary"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textSize="11sp"
                            android:text="@string/whois_lookup" />
                    </LinearLayout>
                </TableRow>

                <!-- Status -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/status" />
                    <TextView
                        android:id="@+id/detail_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        android:textStyle="bold"
                        tools:text="Active"
                        tools:textColor="@color/statusOpen" />
                </TableRow>

                <!-- Error / errno -->
                <TableRow
                    android:id="@+id/error_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/error" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/detail_errno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            android:textColor="@color/warning"
                            tools:text="No route to host (113)" />
                        <ImageView
                            android:id="@+id/error_info"
                            android:layout_gravity="center"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_info" />
                    </LinearLayout>
                </TableRow>

                <!-- URL -->
                <TableRow
                    android:id="@+id/detail_url_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/url" />
                    <TextView
                        android:id="@+id/detail_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="example.com/api/data" />
                </TableRow>

                <!-- Interface -->
                <TableRow
                    android:id="@+id/interface_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/network_interface" />
                    <TextView
                        android:id="@+id/capture_interface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="wlan0" />
                </TableRow>

                <!-- Decryption -->
                <TableRow
                    android:id="@+id/decryption_status_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/decryption" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/decryption_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:adjustViewBounds="true"
                            android:layout_marginEnd="4dp"
                            tools:tint="@color/ok"
                            tools:src="@drawable/ic_lock_open" />
                        <TextView
                            android:id="@+id/detail_decryption_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            tools:text="Decrypted" />
                    </LinearLayout>
                </TableRow>

                <!-- JS Injected scripts -->
                <TableRow
                    android:id="@+id/injected_scripts_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/injected" />
                    <TextView
                        android:id="@+id/injected_scripts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="some script" />
                </TableRow>

                <!-- Country -->
                <TableRow
                    android:id="@+id/country_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/country" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <com.haipq.android.flagkit.FlagImageView
                            android:id="@+id/country_flag"
                            android:layout_width="wrap_content"
                            android:layout_height="14sp"
                            android:layout_marginEnd="6dp"
                            tools:src="@drawable/flag_it" />
                        <TextView
                            android:id="@+id/country_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            tools:text="Italy" />
                    </LinearLayout>
                </TableRow>

                <!-- ASN -->
                <TableRow
                    android:id="@+id/asn_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/asn" />
                    <TextView
                        android:id="@+id/asn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="AS15169 - Google LLC" />
                </TableRow>

                <!-- ── Section divider: Traffic ── -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_span="2"
                        android:background="@color/sectionDivider" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_span="2"
                        android:text="@string/network_traffic"
                        style="@style/StatCardLabel" />
                </TableRow>

                <!-- Bytes -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/network_traffic" />
                    <TextView
                        android:id="@+id/detail_bytes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="1.5 MB received — 0.1 MB sent" />
                </TableRow>

                <!-- Packets -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/packets" />
                    <TextView
                        android:id="@+id/detail_packets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="1.1 K received — 98 sent" />
                </TableRow>

                <!-- Blocked packets -->
                <TableRow
                    android:id="@+id/blocked_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/blocked_pkts" />
                    <TextView
                        android:id="@+id/blocked_pkts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        android:textColor="@color/danger"
                        tools:text="11 pkts" />
                </TableRow>

                <!-- Payload -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/payload" />
                    <TextView
                        android:id="@+id/detail_payload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="0.6 MB" />
                </TableRow>

                <!-- Duration -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/duration" />
                    <TextView
                        android:id="@+id/detail_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="2 min" />
                </TableRow>

                <!-- ── Section divider: Timeline ── -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_span="2"
                        android:background="@color/sectionDivider" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_span="2"
                        android:text="@string/timeline"
                        style="@style/StatCardLabel" />
                </TableRow>

                <!-- First seen -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/first_seen" />
                    <TextView
                        android:id="@+id/first_seen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="01/02/20 00:45:01" />
                </TableRow>

                <!-- Last seen -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/OverviewLabel"
                        android:text="@string/last_seen" />
                    <TextView
                        android:id="@+id/last_seen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        tools:text="01/02/20 00:47:01" />
                </TableRow>

            </TableLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Info / warning message bar (outside table, no copy impact) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/error_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFF8E1">

            <TextView
                android:id="@+id/error_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textColor="@color/warning"
                android:textIsSelectable="true"
                android:lineSpacingMultiplier="1.3"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="The client may not trust the certificate" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
